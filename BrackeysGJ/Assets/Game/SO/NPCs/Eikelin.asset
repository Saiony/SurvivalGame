%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eef5f07579151fc44810d35eb3110eaa, type: 3}
  m_Name: Eikelin
  m_EditorClassIdentifier: 
  StandardDialog:
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: I can't believe she did that to me ... I raised her up so well!
  StartQuestDialog:
  - _portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: "Good morning, kid! What happened?\r"
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: 'My ... Sniff ... My grandmother birthday is tomorrow, and I was going
      to prepare her favorite apple pie.

'
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: "The ingredients were all ready-to-go, but I distracted myself for
      ten seconds and when I noticed, my pet goat had devoured three of the five
      apples I needed to use for the recipe!\r"
  - _portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: Do you have a pet goat?
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: "(...) and using just two apples I won\u2019t be able to make a pie.
      A cupcake, maybe? But not a pie. And my grandma looooooves these pies so much
      ... Snif."
  - _portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: "Well, don\u2019t worry! I\u2019ll help you. "
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: "But\u2026 H-how? Do you know someone who plants apples? Are those
      gourmet apples?!?"
  - _portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: "What? No! I\u2026 I have my ways. Just you wait!"
  WaitingEndQuestDialog:
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: Have you found the apples? Please say yes!
  EndQuestDialog:
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: ' Wow! You really did it! Amazing!'
  - _portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: "Yes, incredible. But you don't need to go around talking about how
      I am a charitable, kind and dedicated soul who loves to help others, okay?
      Unless you want to do that, then I wouldn't complain.\r"
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: "I'm going to start preparing the pies right now! Thank you very much,
      lady. You saved my day!\r"
  AfterQuestDialog:
  - _portrait: {fileID: 11400000, guid: 6d71a8404abeb5c4d826ca4a741ecc2e, type: 2}
    Sentence: Grandma will be so happy with the pies! She may even smile this time!
