%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eef5f07579151fc44810d35eb3110eaa, type: 3}
  m_Name: Kraut
  m_EditorClassIdentifier: 
  StandardDialog:
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: Alas children.  Alas village.
  StartQuestDialog:
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: "The store is did close.  Cometh back later or never. I don\u2019t
      care."
  - Portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: Hey, chill! Are you the herbalist who closed your store?
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: "Yes, yes. \u201CIt is I\u201D. Didst thee cometh to make excit'ment
      of me? Draw mustaches on mine own signeth? Throw rotten egg at mine own window?!?"
  - Portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: Meeeee? No! Of course not! I never, and I repeat, NEVER would draw
      mustaches on private property. Is that the reason you closed your store?
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: "Hmpf\u2026 aye.  I have decided to holp this village with mine own
      years and years of healing exp'rience, but the children in this lodging are
      malapert and cullionly."
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: "Just because I used the ball yond hath fallen in mine yard to prepare
      a potion, those gents vandaliz'd mine store.  It took me days just to crisp
      the egg stuck to the mure, and mine store signeth was completely ruin'd.  Totally!\r"
  - Portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: "That's terrible. But what if I helped you get a new sign? You could
      open it, right? Not all children here are bad, you know... And some of them
      are in need of your potions. It\u2019s flu season.\r"
  - Portrait: {fileID: 11400000, guid: a179e59b5dad9a946ab39766eaaaf094, type: 2}
    Sentence: Aye.  I bethink so. There art kind people in this village. If you give
      me a new signeth, I has't not reason to stayeth close
  - Portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: Great! Perfect! Just for inspiration and for no other reason, could
      I see the sign with the mustaches drawn on it?
  - Portrait: {fileID: 11400000, guid: a179e59b5dad9a946ab39766eaaaf094, type: 2}
    Sentence: "Nay.\r"
  - Portrait: {fileID: 11400000, guid: 54afff23815e15d41a1da07de5a17d50, type: 2}
    Sentence: "Ooook! See you later!\r"
  WaitingEndQuestDialog:
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: Avoid drawing mine own visage on the signe this time.
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: "It may be more difficult to put on mustaches lat\u2019r.\r\n"
  EndQuestDialog:
  - Portrait: {fileID: 0}
    Sentence: 
  AfterQuestDialog:
  - Portrait: {fileID: 11400000, guid: ad96908fbdb840c4f8856e6c30e86dd1, type: 2}
    Sentence: I still und'rstand not these geometric shapes, but i did like the colors.
